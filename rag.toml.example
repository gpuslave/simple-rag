[corpus]
path = "examples"

[models]
generation = "z-ai/glm-5.3-flash"
embedding = "baai/bge-m3"

[gateway]
base_url = "https://routerai.ru/api/v1"

[state]
path = ".rag-state"

[chunking]
size = 800
overlap = 100

